<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Use only nuget.org for restore. The machine-level config points at a corporate Nexus mirror
    (repo-nexus-test.orbis.dedalus.com) that is intermittently unreachable, causing hard NU1301
    restore failures (SSL EOF). All packages used by this repository are public on nuget.org, so
    clearing inherited sources and pinning nuget.org makes restore reliable for local development.
    Adjust or remove this file if you need to restore from an internal feed (e.g. on CI).
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>


